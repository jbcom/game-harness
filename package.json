{
  "name": "@jbcom/game-harness",
  "version": "0.4.3",
  "description": "vitest-browser config + playwright config/preset + release verification ladder for TypeScript browser games — tiered Playwright, deterministic visual-regression battery, Lighthouse CI presets, and a release-ladder orchestrator.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/game-harness.git"
  },
  "files": [
    "bin",
    "dist",
    "maestro",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "test-harness-visual-battery": "./bin/test-harness-visual-battery.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./vitest": {
      "types": "./dist/types/browser-config.d.ts",
      "import": "./dist/esm/browser-config.js",
      "require": "./dist/cjs/browser-config.js"
    },
    "./playwright": {
      "types": "./dist/types/playwright-config.d.ts",
      "import": "./dist/esm/playwright-config.js",
      "require": "./dist/cjs/playwright-config.js"
    },
    "./silent-qa": {
      "types": "./dist/types/silent-qa.d.ts",
      "import": "./dist/esm/silent-qa.js",
      "require": "./dist/cjs/silent-qa.js"
    },
    "./production-runtime": {
      "types": "./dist/types/production-runtime.d.ts",
      "import": "./dist/esm/production-runtime.js",
      "require": "./dist/cjs/production-runtime.js"
    },
    "./chromium": {
      "types": "./dist/types/chromium-launch.d.ts",
      "import": "./dist/esm/chromium-launch.js",
      "require": "./dist/cjs/chromium-launch.js"
    },
    "./lighthouse": {
      "types": "./dist/types/lighthouse.d.ts",
      "import": "./dist/esm/lighthouse.js",
      "require": "./dist/cjs/lighthouse.js"
    },
    "./release-ladder": {
      "types": "./dist/types/release-ladder.d.ts",
      "import": "./dist/esm/release-ladder.js",
      "require": "./dist/cjs/release-ladder.js"
    },
    "./visual-battery": {
      "types": "./dist/types/visual-battery.d.ts",
      "import": "./dist/esm/visual-battery.js",
      "require": "./dist/cjs/visual-battery.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:types && pnpm run build:fixup",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:fixup": "node scripts/fixup-cjs-package-json.mjs",
    "clean": "rimraf dist",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:package": "node scripts/verify-package-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "get-port": "7.2.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <2",
    "@vitest/browser-playwright": ">=4.1.10 <5",
    "vitest": ">=4.1.10 <5"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.10",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/jbcom/game-harness/issues"
  },
  "homepage": "https://github.com/jbcom/game-harness#readme",
  "sideEffects": false
}
