{
  "name": "@jbdevprimary/game-harness",
  "version": "0.5.0",
  "description": "Release-grade browser QA primitives for TypeScript games: silent Playwright/Vitest sessions, deterministic screenshots, runtime proof, and Lighthouse gates.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/game-harness.git"
  },
  "files": [
    "AGENTS.md",
    "bin",
    "CHANGELOG.md",
    "dist",
    "docs",
    "llms.txt",
    "maestro",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "game-harness-visual-battery": "bin/test-harness-visual-battery.mjs",
    "test-harness-visual-battery": "bin/test-harness-visual-battery.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/types/browser-config.d.ts",
        "default": "./dist/esm/browser-config.js"
      },
      "require": {
        "types": "./dist/types/browser-config.d.cts",
        "default": "./dist/cjs/browser-config.js"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/types/playwright-config.d.ts",
        "default": "./dist/esm/playwright-config.js"
      },
      "require": {
        "types": "./dist/types/playwright-config.d.cts",
        "default": "./dist/cjs/playwright-config.js"
      }
    },
    "./silent-qa": {
      "import": {
        "types": "./dist/types/silent-qa.d.ts",
        "default": "./dist/esm/silent-qa.js"
      },
      "require": {
        "types": "./dist/types/silent-qa.d.cts",
        "default": "./dist/cjs/silent-qa.js"
      }
    },
    "./production-runtime": {
      "import": {
        "types": "./dist/types/production-runtime.d.ts",
        "default": "./dist/esm/production-runtime.js"
      },
      "require": {
        "types": "./dist/types/production-runtime.d.cts",
        "default": "./dist/cjs/production-runtime.js"
      }
    },
    "./chromium": {
      "import": {
        "types": "./dist/types/chromium-launch.d.ts",
        "default": "./dist/esm/chromium-launch.js"
      },
      "require": {
        "types": "./dist/types/chromium-launch.d.cts",
        "default": "./dist/cjs/chromium-launch.js"
      }
    },
    "./lighthouse": {
      "import": {
        "types": "./dist/types/lighthouse.d.ts",
        "default": "./dist/esm/lighthouse.js"
      },
      "require": {
        "types": "./dist/types/lighthouse.d.cts",
        "default": "./dist/cjs/lighthouse.js"
      }
    },
    "./release-ladder": {
      "import": {
        "types": "./dist/types/release-ladder.d.ts",
        "default": "./dist/esm/release-ladder.js"
      },
      "require": {
        "types": "./dist/types/release-ladder.d.cts",
        "default": "./dist/cjs/release-ladder.js"
      }
    },
    "./visual-battery": {
      "import": {
        "types": "./dist/types/visual-battery.d.ts",
        "default": "./dist/esm/visual-battery.js"
      },
      "require": {
        "types": "./dist/types/visual-battery.d.cts",
        "default": "./dist/cjs/visual-battery.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:types && pnpm run build:fixup",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:fixup": "node scripts/fixup-cjs-package-json.mjs",
    "clean": "rimraf dist",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src tests scripts",
    "package:check": "publint && attw --pack . --profile node16",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:package": "node scripts/verify-package-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run package:check && pnpm run test:package"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "get-port": "7.2.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <2",
    "@vitest/browser-playwright": ">=4.1.10 <5",
    "vitest": ">=4.1.10 <5"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.62.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "oxlint": "1.79.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/jbcom/game-harness/issues"
  },
  "homepage": "https://github.com/jbcom/game-harness#readme",
  "sideEffects": false,
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "keywords": [
    "vitest",
    "playwright",
    "testing",
    "browser-testing",
    "visual-regression",
    "lighthouse",
    "ci",
    "game-dev"
  ]
}
